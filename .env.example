# Copy to .env and fill in. .env is git-ignored; never commit a real key.
ANTHROPIC_API_KEY=

# Extraction model. Default: claude-opus-5-5. Lighter option for comparison: claude-haiku-5-5
QUOTEFLOW_MODEL=
# low | medium | high (default: medium)
QUOTEFLOW_EFFORT=

# Network behaviour: SDK retries (default 3) and per-attempt timeout in seconds (default 60)
QUOTEFLOW_MAX_RETRIES=
QUOTEFLOW_TIMEOUT_SECONDS=
# Re-run a refused request on a fallback model where supported (default: true)
QUOTEFLOW_REFUSAL_FALLBACK=

# Optional overrides
QUOTEFLOW_PRICE_LIST=
QUOTEFLOW_PRICING_RULES=
QUOTEFLOW_LOG_DIR=
